#!/bin/bash
# ============================================================
# Menu de Gerenciamento - Dtmod-MB4Core
# ============================================================

# Cores
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Localiza o PM2 mesmo quando o shell que chama o menu não herdou o PATH do npm.
resolve_pm2() {
    local candidate
    for candidate in "$(command -v pm2 2>/dev/null || true)" \
        "$(npm prefix -g 2>/dev/null || true)/bin/pm2" \
        "/usr/local/bin/pm2" "/usr/bin/pm2"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}
PM2_BIN="$(resolve_pm2 || true)"

# ============================================================
# DETECÇÃO ROBUSTA DO DIRETÓRIO DE INSTALAÇÃO
# Prioridade: .install_dir > /root/Dtmod > $HOME/Dtmod > dirname do script
# ============================================================
PANEL_DIR=""

if [ -f "$HOME/Dtmod/.install_dir" ]; then
    PANEL_DIR="$(cat "$HOME/Dtmod/.install_dir")"
elif [ -f "/root/Dtmod/.install_dir" ]; then
    PANEL_DIR="$(cat /root/Dtmod/.install_dir)"
elif [ -f "$HOME/.install_dir" ]; then
    PANEL_DIR="$(cat "$HOME/.install_dir")"
elif [ -d "/root/Dtmod" ] && [ -f "/root/Dtmod/ecosystem.config.js" ]; then
    PANEL_DIR="/root/Dtmod"
elif [ -d "$HOME/Dtmod" ] && [ -f "$HOME/Dtmod/ecosystem.config.js" ]; then
    PANEL_DIR="$HOME/Dtmod"
else
    RESOLVED="$(readlink -f "$0" 2>/dev/null)"
    if [ -n "$RESOLVED" ] && [ -f "$(dirname "$RESOLVED")/ecosystem.config.js" ]; then
        PANEL_DIR="$(dirname "$RESOLVED")"
    fi
fi

if [ -z "$PANEL_DIR" ] || [ ! -f "$PANEL_DIR/ecosystem.config.js" ]; then
    echo -e "${RED}Erro: Diretorio do painel nao encontrado!${NC}"
    exit 1
fi

ENV_FILE="$PANEL_DIR/.env"
export DTMOD_INSTALL_DIR="$PANEL_DIR"

show_menu() {
    clear
    echo -e "${GREEN}=======================================${NC}"
    echo -e "${GREEN}      BEM VINDO AO DTMOD-MB4CORE         ${NC}"
    echo -e "${GREEN}=======================================${NC}"
    echo ""
    echo -e "${CYAN}1.${NC} Fazer backup"
    echo -e "${CYAN}2.${NC} Restaurar backup"
    echo -e "${CYAN}3.${NC} Reiniciar painel"
    echo -e "${CYAN}4.${NC} Ativar Auto backup"
    echo -e "${CYAN}5.${NC} Remover painel"
    echo -e "${CYAN}6.${NC} Gerar Aplicativo (APK)"
    # Obter porta atual para exibição no menu
    CURRENT_PORT=$(grep "^PORT=" "$ENV_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d ' ')
    [ -z "$CURRENT_PORT" ] && CURRENT_PORT="3000"
    echo -e "${CYAN}7.${NC} Configurar porta do painel ${YELLOW}(Atual: $CURRENT_PORT)${NC}"
    echo -e "${CYAN}8.${NC} Criar ou mudar Super ADM"
    echo -e "${CYAN}9.${NC} Atualizar painel pelo GitHub"
    echo -e "${CYAN}0.${NC} Sair"
    echo ""
    echo -n -e "${GREEN}Escolha uma opcao: ${NC}"
}

while true; do
    show_menu
    read opt
    case $opt in
        1)
            echo "Fazendo backup..."
            BACKUP_FILE="$HOME/dtmod_backup_$(date +%F_%H-%M).tar.gz"
            tar -czf "$BACKUP_FILE" -C "$(dirname "$PANEL_DIR")" "$(basename "$PANEL_DIR")"
            echo -e "${GREEN}Backup concluido em $BACKUP_FILE${NC}"
            sleep 2
            ;;
        2)
            echo "Escolha o arquivo de backup (.tar.gz):"
            ls "$HOME"/dtmod_backup_*.tar.gz 2>/dev/null || echo "Nenhum backup encontrado em $HOME"
            echo -n "Caminho do backup: "
            read backup_path
            if [ -f "$backup_path" ]; then
                echo "Restaurando backup..."
                tar -xzf "$backup_path" -C "$(dirname "$PANEL_DIR")"
                echo -e "${GREEN}Backup restaurado com sucesso!${NC}"
                cd "$PANEL_DIR"
                pnpm exec prisma db push
                "$PANEL_DIR/pon"
            else
                echo -e "${RED}Arquivo de backup nao encontrado!${NC}"
            fi
            sleep 2
            ;;
        3)
            echo "Reiniciando painel..."
            if [ -z "$PM2_BIN" ]; then
                echo -e "${RED}PM2 nao foi encontrado. Verifique a instalacao global do PM2.${NC}"
            elif ! cd "$PANEL_DIR"; then
                echo -e "${RED}Nao foi possivel acessar o diretorio do painel: $PANEL_DIR${NC}"
            elif "$PM2_BIN" show DTunnel >/dev/null 2>&1; then
                if "$PM2_BIN" restart DTunnel --update-env; then
                    "$PM2_BIN" save
                    echo -e "${GREEN}Painel reiniciado com sucesso.${NC}"
                else
                    echo -e "${RED}Falha ao reiniciar DTunnel. Confira: pm2 logs DTunnel${NC}"
                fi
            elif "$PM2_BIN" start ecosystem.config.js --cwd "$PANEL_DIR"; then
                "$PM2_BIN" save
                echo -e "${GREEN}Painel iniciado com sucesso.${NC}"
            else
                echo -e "${RED}Falha ao iniciar DTunnel. Confira: pm2 logs DTunnel${NC}"
            fi
            sleep 2
            ;;
        4)
            echo "Auto backup ativado."
            (crontab -l 2>/dev/null; echo "0 3 * * * tar -czf $HOME/dtmod_backup_auto_\$(date +\%F).tar.gz -C $(dirname "$PANEL_DIR") $(basename "$PANEL_DIR")") | sort -u | crontab -
            echo -e "${GREEN}Auto backup configurado!${NC}"
            sleep 2
            ;;
        5)
            echo -e "${RED}Removendo painel...${NC}"
            echo -n "Tem certeza? (s/n): "
            read confirm
            if [ "$confirm" = "s" ] || [ "$confirm" = "S" ]; then
                "$PM2_BIN" delete DTunnel 2>/dev/null
                "$PM2_BIN" save 2>/dev/null
                rm -f /usr/local/bin/menuop /usr/local/bin/pon /usr/local/bin/poff
                echo -e "${RED}Painel removido!${NC}"
                sleep 2
                exit 0
            fi
            ;;
        6)
            echo -e "${CYAN}--- GERADOR DE APLICATIVO ---${NC}"
            
            # Verificar dependências, em vez de continuar silenciosamente com downloads falhos.
            if ! command -v java >/dev/null 2>&1 || ! command -v apktool >/dev/null 2>&1 || ! apktool --version >/dev/null 2>&1; then
                echo -e "${YELLOW}Instalando dependencias necessarias (Java, Apktool)...${NC}"
                SUDO=()
                if [ "$(id -u)" -ne 0 ]; then
                    if command -v sudo >/dev/null 2>&1; then
                        SUDO=(sudo)
                    else
                        echo -e "${RED}Execute esta opção como root ou instale sudo para preparar Java/Apktool.${NC}"
                        sleep 3
                        continue
                    fi
                fi
                if ! "${SUDO[@]}" apt-get update || ! "${SUDO[@]}" apt-get install -y openjdk-17-jdk-headless wget python3; then
                    echo -e "${RED}Falha ao instalar Java e ferramentas básicas. Verifique a conexão e os logs do apt.${NC}"
                    sleep 3
                    continue
                fi
                if ! command -v wget >/dev/null 2>&1 \
                    || ! "${SUDO[@]}" wget -q https://raw.githubusercontent.com/iBotPeaches/Apktool/master/scripts/linux/apktool -O /usr/local/bin/apktool \
                    || ! "${SUDO[@]}" wget -q https://github.com/iBotPeaches/Apktool/releases/download/v3.0.3/apktool_3.0.3.jar -O /usr/local/bin/apktool.jar \
                    || ! "${SUDO[@]}" wget -q https://github.com/patrickfav/uber-apk-signer/releases/download/v1.3.0/uber-apk-signer-1.3.0.jar -O /usr/local/bin/uber-apk-signer.jar; then
                    echo -e "${RED}Falha ao baixar Apktool ou o assinador de APK. Nenhum build foi iniciado.${NC}"
                    sleep 3
                    continue
                fi
                if ! "${SUDO[@]}" chmod 0755 /usr/local/bin/apktool \
                    || ! "${SUDO[@]}" chmod 0644 /usr/local/bin/apktool.jar /usr/local/bin/uber-apk-signer.jar \
                    || [ ! -s /usr/local/bin/apktool.jar ] \
                    || [ ! -s /usr/local/bin/uber-apk-signer.jar ] \
                    || ! java -jar /usr/local/bin/apktool.jar --version >/dev/null 2>&1; then
                    echo -e "${RED}As ferramentas baixadas estão incompletas ou inválidas. Verifique /usr/local/bin.${NC}"
                    sleep 3
                    continue
                fi
            fi
            if ! command -v java >/dev/null 2>&1 || ! command -v apktool >/dev/null 2>&1 || ! apktool --version >/dev/null 2>&1; then
                echo -e "${RED}Java ou Apktool continua indisponível; geração cancelada antes de criar a chave FCM.${NC}"
                sleep 3
                continue
            fi

            echo -n "Digite o seu dominio (ex: meu-painel.com): "
            read domain

            if [ -z "$domain" ]; then
                echo -e "${RED}Dominio invalido!${NC}"
            else
                if [ ! -s "$PANEL_DIR/scripts/base.apk" ]; then
                    echo -e "${RED}APK base ausente ou vazia: $PANEL_DIR/scripts/base.apk${NC}"
                    sleep 3
                    continue
                fi
                # A geração via menuop também precisa registrar a chave FCM
                # por conta e repassá-la ao gerador em uma variável de ambiente.
                OUTPUT_APK="${HOME%/}/dtmod-custom.apk"
                APK_SRC=""
                REGISTRATION_DATA=""
                USER_ID=""
                REGISTRATION_KEY=""
                rm -f "$OUTPUT_APK"
                if REGISTRATION_DATA=$(python3 "$PANEL_DIR/scripts/prepare_cli_apk_registration.py" "$PANEL_DIR" create); then
                    IFS=$'\t' read -r USER_ID REGISTRATION_KEY <<< "$REGISTRATION_DATA"
                    if [ -z "$USER_ID" ] || [ -z "$REGISTRATION_KEY" ]; then
                        echo -e "${RED}Não foi possível preparar o registro FCM no banco do painel.${NC}"
                    else
                        echo -e "${YELLOW}Iniciando geracao do APK para: $domain${NC}"
                        echo -e "${CYAN}user_id aplicado automaticamente: $USER_ID${NC}"
                        # A chave segue apenas no ambiente do gerador; stdin fica
                        # fechado para impedir que ferramentas filhas a leiam.
                        export DTUNNEL_FCM_REGISTRATION_KEY="$REGISTRATION_KEY"
                        if python3 "$PANEL_DIR/scripts/generate_apk.py" "$domain" "$USER_ID" "$OUTPUT_APK" && [ -s "$OUTPUT_APK" ]; then
                            APK_SRC="$OUTPUT_APK"
                        else
                            printf '%s' "$REGISTRATION_KEY" | python3 "$PANEL_DIR/scripts/prepare_cli_apk_registration.py" "$PANEL_DIR" revoke
                            echo -e "${RED}Falha no build; a chave temporária de registro FCM foi removida.${NC}"
                        fi
                        unset DTUNNEL_FCM_REGISTRATION_KEY
                    fi
                else
                    echo -e "${RED}Não foi possível preparar o registro FCM para este APK.${NC}"
                fi

                if [ -n "$APK_SRC" ] && [ -s "$APK_SRC" ]; then
                    DOWNLOAD_DIR="$PANEL_DIR/frontend/public/downloads"
                    FINAL_APK="$DOWNLOAD_DIR/app-$(date +%s)-$$.apk"
                    TEMP_APK="$FINAL_APK.tmp.$$"
                    if mkdir -p "$DOWNLOAD_DIR" \
                        && cp "$APK_SRC" "$TEMP_APK" \
                        && [ -s "$TEMP_APK" ] \
                        && chmod 0644 "$TEMP_APK" \
                        && mv -f "$TEMP_APK" "$FINAL_APK"; then
                        rm -f "$APK_SRC"
                        echo -e "${GREEN}APK gerado e publicado com sucesso!${NC}"
                        echo -e "Disponivel em: $FINAL_APK"
                    else
                        rm -f "$TEMP_APK"
                        echo -e "${RED}O APK foi gerado, mas não pôde ser publicado em $DOWNLOAD_DIR.${NC}"
                        echo -e "${YELLOW}O arquivo intermediário foi mantido para recuperação: $APK_SRC${NC}"
                        if [ -n "$REGISTRATION_KEY" ]; then
                            if ! printf '%s' "$REGISTRATION_KEY" | python3 "$PANEL_DIR/scripts/prepare_cli_apk_registration.py" "$PANEL_DIR" revoke; then
                                echo -e "${RED}Aviso: não foi possível remover a chave FCM temporária.${NC}"
                            fi
                        fi
                    fi
                else
                    echo -e "${RED}Erro ao gerar o APK. Verifique os logs acima.${NC}"
                fi
            fi
            sleep 3
            ;;
        7)
            # --- Opção 7: Configurar porta do painel ---
            if [ -z "$PM2_BIN" ]; then
                echo -e "${RED}PM2 não foi encontrado neste VPS.${NC}"
                echo -e "${YELLOW}Instale-o com: npm install -g pm2${NC}"
                sleep 3
                continue
            fi

            # Obter porta atual para referência
            OLD_PORT=$(grep "^PORT=" "$ENV_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d ' ')
            [ -z "$OLD_PORT" ] && OLD_PORT="3000"
            echo -e "${CYAN}Porta atual: ${YELLOW}$OLD_PORT${NC}"
            echo -e "${CYAN}Exemplo: 80, 3000, 8080${NC}"
            echo ""
            echo -n "Digite a nova porta: "
            read new_port
            
            if [[ "$new_port" =~ ^[0-9]+$ ]] && [ "$new_port" -gt 0 ] && [ "$new_port" -le 65535 ]; then
                # 1. Parar o painel completamente (remover do PM2)
                echo -e "${YELLOW}Parando painel...${NC}"
                "$PM2_BIN" delete DTunnel 2>/dev/null
                "$PM2_BIN" save 2>/dev/null
                sleep 1
                
                # 2. Verificar que não há processo preso na porta
                CURRENT_PID=$(lsof -nP -t -iTCP:"$new_port" -sTCP:LISTEN 2>/dev/null | head -1)
                if [ -n "$CURRENT_PID" ]; then
                    echo -e "${YELLOW}Finalizando processo preso na porta $new_port (PID: $CURRENT_PID)...${NC}"
                    kill -9 "$CURRENT_PID" 2>/dev/null
                    sleep 1
                fi
                
                # 3. Atualizar o .env com a nova porta
                if [ ! -f "$ENV_FILE" ]; then
                    cp "$PANEL_DIR/.env.example" "$ENV_FILE"
                fi
                
                # Substituir PORT= existente OU adicionar se não existir
                if grep -q "^PORT=" "$ENV_FILE" 2>/dev/null; then
                    sed -i "s/^PORT=.*/PORT=$new_port/" "$ENV_FILE"
                else
                    echo "PORT=$new_port" >> "$ENV_FILE"
                fi
                
                # Verificar que a porta foi realmente gravada
                CHECK_PORT=$(grep "^PORT=" "$ENV_FILE" | cut -d'=' -f2 | tr -d ' ')
                if [ "$CHECK_PORT" != "$new_port" ]; then
                    echo -e "${RED}Erro ao salvar porta no .env!${NC}"
                    sleep 2
                    continue
                fi
                
                # 4. Configurar firewall: remover regra antiga, abrir nova
                if command -v ufw &> /dev/null; then
                    ufw delete allow "$OLD_PORT"/tcp 2>/dev/null
                    ufw allow "$new_port"/tcp 2>/dev/null
                fi
                if command -v iptables &> /dev/null; then
                    iptables -I INPUT -p tcp --dport "$new_port" -j ACCEPT 2>/dev/null
                fi
                
                # 5. Reiniciar o painel com a nova porta
                echo -e "${YELLOW}Reiniciando painel na porta $new_port...${NC}"
                cd "$PANEL_DIR"
                "$PM2_BIN" start ecosystem.config.js --cwd "$PANEL_DIR"
                "$PM2_BIN" save
                sleep 3

                # 6. Verificar o processo e a porta realmente em escuta
                ACTUAL_PORT=$(grep "^PORT=" "$ENV_FILE" | cut -d'=' -f2 | tr -d ' ')
                RUNNING_STATUS=$("$PM2_BIN" show DTunnel 2>/dev/null | grep -i "status" || true)
                LISTENING_PID=$(lsof -nP -t -iTCP:"$new_port" -sTCP:LISTEN 2>/dev/null | head -1)
                
                if "$PM2_BIN" show DTunnel >/dev/null 2>&1 && [ -n "$LISTENING_PID" ]; then
                    echo -e "${GREEN}==============================================${NC}"
                    echo -e "${GREEN}  Porta alterada com sucesso para: $new_port    ${NC}"
                    echo -e "${GREEN}==============================================${NC}"
                    echo -e "${CYAN}  Acesse: http://SEU-IP:$new_port              ${NC}"
                    echo -e "${GREEN}==============================================${NC}"
                else
                    echo -e "${RED}Aviso: Painel nao iniciou corretamente. Verifique:${NC}"
                    echo -e "${RED}  pm2 logs DTunnel${NC}"
                fi
            else
                echo -e "${RED}Porta invalida! Use numeros entre 1 e 65535.${NC}"
            fi
            sleep 3
            ;;
        8)
            echo -e "${CYAN}--- CRIAR OU ALTERAR SUPER ADMINISTRADOR ---${NC}"
            cd "$PANEL_DIR" && pnpm exec tsx scripts/update-admin-credentials.ts
            sleep 3
            ;;
        9)
            echo -e "${CYAN}--- ATUALIZAR PAINEL PELO GITHUB ---${NC}"
            if DTMOD_INSTALL_DIR="$PANEL_DIR" PM2_BIN="$PM2_BIN" bash "$PANEL_DIR/scripts/update_panel.sh"; then
                echo -e "${GREEN}Verificação da atualização concluída.${NC}"
            else
                update_status=$?
                echo -e "${RED}Falha na opção 9 (código $update_status). Leia o erro acima; nenhuma confirmação de sucesso foi emitida.${NC}"
            fi
            echo ""
            read -r -p "Pressione Enter para voltar ao menu..." _
            ;;
        0)
            exit 0
            ;;
        *)
            echo -e "${RED}Opcao invalida!${NC}"
            sleep 1
            ;;
    esac
done
