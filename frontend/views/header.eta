<nav class="header">
  <button id="openNav" type="button" aria-label="Abrir menu">
    <i class="bi bi-list-nested" aria-hidden="true"></i>
  </button>
  <div class="d-flex align-items-center">
    <div class="panel-theme-picker">
      <button id="toggle-theme-btn" class="btn btn-sm btn-dark rounded-circle panel-theme-trigger" type="button" aria-label="Mudar cor do painel" aria-haspopup="true" aria-expanded="false" aria-controls="theme-palette">
        <i id="toggle-theme-icon" class="bi bi-palette-fill" aria-hidden="true"></i>
      </button>
      <div id="theme-palette" class="panel-theme-palette" role="group" aria-label="Escolha a cor do painel" hidden>
        <span class="panel-theme-title">Cor do painel</span>
        <button class="panel-theme-swatch" type="button" data-panel-theme="violet" aria-label="Roxo" title="Roxo"></button>
        <button class="panel-theme-swatch" type="button" data-panel-theme="sky" aria-label="Azul claro" title="Azul claro"></button>
        <button class="panel-theme-swatch" type="button" data-panel-theme="mint" aria-label="Verde menta" title="Verde menta"></button>
        <button class="panel-theme-swatch" type="button" data-panel-theme="orange" aria-label="Laranja" title="Laranja"></button>
        <button class="panel-theme-swatch" type="button" data-panel-theme="navy" aria-label="Azul marinho" title="Azul marinho"></button>
        <button class="panel-theme-swatch" type="button" data-panel-theme="pink" aria-label="Rosa" title="Rosa"></button>
        <button class="panel-theme-swatch" type="button" data-panel-theme="teal" aria-label="Turquesa" title="Turquesa"></button>
        <button class="panel-theme-swatch" type="button" data-panel-theme="amber" aria-label="Amarelo" title="Amarelo"></button>
      </div>
    </div>
    <a href="/profile" target="_self">
      <%= it.user.username %>
      <img src="../static/img/icon.jpg?v=20260815-nexus-2" width="30" height="30" class="d-inline-block ms-2 img-rounded" alt="">
    </a>
  </div>
</nav>
